{
  "name": "nexo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "NEXO_HUB", "class_name": "NexoHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NexoHub"] }]
}
